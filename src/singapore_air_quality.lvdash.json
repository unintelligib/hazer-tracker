{
  "datasets": [
    {
      "displayName": "current_status",
      "name": "e57623e5",
      "queryLines": [
        "   SELECT\n",
        "     psi_max,\n",
        "     psi_band,\n",
        "     psi_band_order,\n",
        "     is_high_haze,\n",
        "        CASE WHEN is_high_haze THEN 'VERY UNHEALTHY OR WORSE'\n",
        "        WHEN NOT is_high_haze THEN 'No hazardous alert'\n",
        "        ELSE 'Unknown' END AS haze_flag,\n",
        "     worst_region,\n",
        "     pm25_avg,\n",
        "     concat(date_format(reading_date_sgt, 'd MMM'), ', ',\n",
        "            lpad(reading_hour_sgt, 2, '0'), ':00 SGT')       AS as_of_sgt,\n",
        "     timestampdiff(MINUTE, reading_ts, current_timestamp())  AS minutes_since_reading\n",
        "   FROM workspace.hazer.gold_hourly_island\n",
        "   ORDER BY reading_ts DESC\n",
        "   LIMIT 1;"
      ]
    },
    {
      "displayName": "region_map",
      "name": "7992c3d9",
      "queryLines": [
        "SELECT\n",
        "  g.region,\n",
        "  r.latitude,\n",
        "  r.longitude,\n",
        "  g.psi_24hr,\n",
        "  g.psi_band,\n",
        "  g.psi_band_order,\n",
        "  g.pm25_1hr\n",
        "FROM workspace.hazer.gold_hourly_region g\n",
        "JOIN workspace.hazer.ref_regions r ON g.region = r.region\n",
        "WHERE g.reading_ts = (SELECT max(reading_ts) FROM workspace.hazer.gold_hourly_region)\n",
        "ORDER BY g.region;"
      ]
    },
    {
      "displayName": "pm25_trend",
      "name": "7b1a2a02",
      "queryLines": [
        "WITH win AS (\n",
        "  SELECT max(reading_ts) - INTERVAL 47 HOURS AS start_ts\n",
        "  FROM workspace.hazer.gold_hourly_region\n",
        ")\n",
        "SELECT\n",
        "  CAST(concat(reading_date_sgt, ' ', lpad(reading_hour_sgt, 2, '0'), ':00:00')\n",
        "       AS TIMESTAMP_NTZ)       AS reading_time_sgt,\n",
        "  'Island average'             AS series,\n",
        "  pm25_avg                     AS pm25_1hr\n",
        "FROM workspace.hazer.gold_hourly_island, win\n",
        "WHERE reading_ts >= win.start_ts\n",
        "\n",
        "UNION ALL\n",
        "\n",
        "SELECT\n",
        "  CAST(concat(reading_date_sgt, ' ', lpad(reading_hour_sgt, 2, '0'), ':00:00')\n",
        "       AS TIMESTAMP_NTZ),\n",
        "  region,\n",
        "  pm25_1hr\n",
        "FROM workspace.hazer.gold_hourly_region, win\n",
        "WHERE reading_ts >= win.start_ts\n",
        "\n",
        "ORDER BY reading_time_sgt, series;"
      ]
    },
    {
      "displayName": "daily_comparison",
      "name": "0fa6348e",
      "queryLines": [
        "SELECT\n",
        "  reading_date_sgt,\n",
        "  date_format(reading_date_sgt, 'EEE d MMM') AS day_label,\n",
        "  psi_max,\n",
        "  psi_avg,\n",
        "  pm25_avg,\n",
        "  hours_very_unhealthy\n",
        "FROM workspace.hazer.gold_daily_island\n",
        "WHERE is_complete_day\n",
        "ORDER BY reading_date_sgt DESC\n",
        "LIMIT 7;"
      ]
    },
    {
      "displayName": "vs_yesterday",
      "name": "fc859c24",
      "queryLines": [
        "SELECT\n",
        "  t.psi_max          AS psi_now,\n",
        "  y.psi_max          AS psi_yesterday,\n",
        "  t.psi_max - y.psi_max AS psi_change,\n",
        "  t.pm25_avg         AS pm25_now,\n",
        "  y.pm25_avg         AS pm25_yesterday,\n",
        "  t.pm25_avg - y.pm25_avg AS pm25_change\n",
        "FROM workspace.hazer.gold_hourly_island t\n",
        "LEFT JOIN workspace.hazer.gold_hourly_island y\n",
        "  ON y.reading_ts = t.reading_ts - INTERVAL 24 HOURS\n",
        "WHERE t.reading_ts = (SELECT max(reading_ts) FROM workspace.hazer.gold_hourly_island);"
      ]
    },
    {
      "displayName": "forecast_chart",
      "name": "6b4e0612",
      "queryLines": [
        "   WITH latest AS (\n",
        "     SELECT * FROM workspace.hazer.gold_forecast\n",
        "     WHERE origin_ts = (SELECT max(origin_ts) FROM workspace.hazer.gold_forecast)\n",
        "   ),\n",
        "   win AS (SELECT max(origin_ts) - INTERVAL 23 HOURS AS start_ts FROM latest)\n",
        "   SELECT\n",
        "     CAST(concat(reading_date_sgt, ' ', lpad(reading_hour_sgt, 2, '0'), ':00:00') AS TIMESTAMP_NTZ) AS time_sgt,\n",
        "     'Actual' AS series,\n",
        "     pm25_avg AS pm25\n",
        "   FROM workspace.hazer.gold_hourly_island, win\n",
        "   WHERE reading_ts >= win.start_ts AND pm25_avg IS NOT NULL\n",
        "\n",
        "   UNION ALL\n",
        "\n",
        "   SELECT\n",
        "     CAST(concat(target_date_sgt, ' ', lpad(target_hour_sgt, 2, '0'), ':00:00') AS TIMESTAMP_NTZ),\n",
        "     s.series,\n",
        "     s.pm25\n",
        "   FROM latest\n",
        "   LATERAL VIEW stack(3, 'Forecast', pm25_forecast,\n",
        "                         'Likely range, low', pm25_lower,\n",
        "                         'Likely range, high', pm25_upper) s AS series, pm25\n",
        "\n",
        "   UNION ALL\n",
        "\n",
        "   -- Start each forecast line at the latest reading so it joins the actual line\n",
        "   SELECT DISTINCT\n",
        "     CAST(concat(origin_date_sgt, ' ', lpad(origin_hour_sgt, 2, '0'), ':00:00') AS TIMESTAMP_NTZ),\n",
        "     s.series,\n",
        "     pm25_now\n",
        "   FROM latest\n",
        "   LATERAL VIEW explode(array('Forecast', 'Likely range, low', 'Likely range, high')) s AS series\n",
        "\n",
        "   ORDER BY time_sgt, series;"
      ]
    },
    {
      "displayName": "forecast_table",
      "name": "1074f68c",
      "queryLines": [
        "   SELECT\n",
        "     horizon_h,\n",
        "     concat('+', horizon_h, ' h')                                  AS horizon,\n",
        "     concat(date_format(target_date_sgt, 'EEE d MMM'), ', ',\n",
        "            lpad(target_hour_sgt, 2, '0'), ':00 SGT')               AS for_time_sgt,\n",
        "     CAST(round(pm25_forecast) AS INT)                              AS forecast,\n",
        "     concat(CAST(round(pm25_lower) AS INT), '–',\n",
        "            CAST(round(pm25_upper) AS INT))                         AS likely_range,\n",
        "     CAST(round(pm25_now) AS INT)                                   AS now\n",
        "   FROM workspace.hazer.gold_forecast\n",
        "   WHERE origin_ts = (SELECT max(origin_ts) FROM workspace.hazer.gold_forecast)\n",
        "   ORDER BY horizon_h;"
      ]
    },
    {
      "displayName": "update_status",
      "name": "38da1e43",
      "queryLines": [
        "WITH h AS (\n",
        "  SELECT * FROM workspace.hazer.gold_hourly_island\n",
        "  ORDER BY reading_ts DESC LIMIT 1\n",
        "),\n",
        "f AS (\n",
        "  SELECT origin_ts, origin_date_sgt, origin_hour_sgt, max(written_at) AS written_at\n",
        "  FROM workspace.hazer.gold_forecast\n",
        "  WHERE origin_ts = (SELECT max(origin_ts) FROM workspace.hazer.gold_forecast)\n",
        "  GROUP BY origin_ts, origin_date_sgt, origin_hour_sgt\n",
        ")\n",
        "SELECT\n",
        "  concat(date_format(h.reading_date_sgt, 'd MMM'), ', ',\n",
        "         lpad(h.reading_hour_sgt, 2, '0'), ':00 SGT')                 AS latest_reading_sgt,\n",
        "  timestampdiff(MINUTE, h.reading_ts, current_timestamp())            AS minutes_since_reading,\n",
        "  CASE WHEN timestampdiff(MINUTE, h.reading_ts, current_timestamp()) <= 120\n",
        "       THEN 'Up to date' ELSE 'Delayed' END                           AS data_status,\n",
        "  concat(date_format(f.origin_date_sgt, 'd MMM'), ', ',\n",
        "         lpad(f.origin_hour_sgt, 2, '0'), ':00 SGT')                  AS latest_forecast_from_sgt,\n",
        "  date_format(from_utc_timestamp(f.written_at, 'Asia/Singapore'),\n",
        "              'd MMM, HH:mm')                                         AS forecast_written_sgt\n",
        "FROM h CROSS JOIN f;\n"
      ]
    }
  ],
