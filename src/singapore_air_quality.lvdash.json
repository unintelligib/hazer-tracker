{
  "datasets": [
    {
      "displayName": "current_status",
      "name": "e57623e5",
      "queryLines": [
        "   SELECT\n",
        "     psi_max,\n",
        "     psi_band,\n",
        "     psi_band_order,\n",
        "     is_high_haze,\n",
        "        CASE WHEN is_high_haze THEN 'HIGH HAZE'\n",
        "        WHEN NOT is_high_haze THEN 'No high-haze alert'\n",
        "        ELSE 'Unknown' END AS haze_flag,\n",
        "     worst_region,\n",
        "     pm25_avg,\n",
        "     concat(date_format(reading_date_sgt, 'd MMM'), ', ',\n",
        "            lpad(reading_hour_sgt, 2, '0'), ':00 SGT')       AS as_of_sgt,\n",
        "     timestampdiff(MINUTE, reading_ts, current_timestamp())  AS minutes_since_reading\n",
        "   FROM workspace.hazer.gold_hourly_island\n",
        "   ORDER BY reading_ts DESC\n",
        "   LIMIT 1;"
      ]
    },
    {
      "displayName": "region_map",
      "name": "7992c3d9",
      "queryLines": [
        "SELECT\n",
        "  g.region,\n",
        "  r.latitude,\n",
        "  r.longitude,\n",
        "  g.psi_24hr,\n",
        "  g.psi_band,\n",
        "  g.psi_band_order,\n",
        "  g.pm25_1hr\n",
        "FROM workspace.hazer.gold_hourly_region g\n",
        "JOIN workspace.hazer.ref_regions r ON g.region = r.region\n",
        "WHERE g.reading_ts = (SELECT max(reading_ts) FROM workspace.hazer.gold_hourly_region)\n",
        "ORDER BY g.region;"
      ]
    },
    {
      "displayName": "pm25_trend",
      "name": "7b1a2a02",
      "queryLines": [
        "WITH win AS (\n",
        "  SELECT max(reading_ts) - INTERVAL 47 HOURS AS start_ts\n",
        "  FROM workspace.hazer.gold_hourly_region\n",
        ")\n",
        "SELECT\n",
        "  CAST(concat(reading_date_sgt, ' ', lpad(reading_hour_sgt, 2, '0'), ':00:00')\n",
        "       AS TIMESTAMP_NTZ)       AS reading_time_sgt,\n",
        "  'Island average'             AS series,\n",
        "  pm25_avg                     AS pm25_1hr\n",
        "FROM workspace.hazer.gold_hourly_island, win\n",
        "WHERE reading_ts >= win.start_ts\n",
        "\n",
        "UNION ALL\n",
        "\n",
        "SELECT\n",
        "  CAST(concat(reading_date_sgt, ' ', lpad(reading_hour_sgt, 2, '0'), ':00:00')\n",
        "       AS TIMESTAMP_NTZ),\n",
        "  region,\n",
        "  pm25_1hr\n",
        "FROM workspace.hazer.gold_hourly_region, win\n",
        "WHERE reading_ts >= win.start_ts\n",
        "\n",
        "ORDER BY reading_time_sgt, series;"
      ]
    },
    {
      "displayName": "daily_comparison",
      "name": "0fa6348e",
      "queryLines": [
        "SELECT\n",
        "  reading_date_sgt,\n",
        "  date_format(reading_date_sgt, 'EEE d MMM') AS day_label,\n",
        "  psi_max,\n",
        "  psi_avg,\n",
        "  pm25_avg,\n",
        "  hours_very_unhealthy\n",
        "FROM workspace.hazer.gold_daily_island\n",
        "WHERE is_complete_day\n",
        "ORDER BY reading_date_sgt DESC\n",
        "LIMIT 7;"
      ]
    },
    {
      "displayName": "vs_yesterday",
      "name": "fc859c24",
      "queryLines": [
        "SELECT\n",
        "  t.psi_max          AS psi_now,\n",
        "  y.psi_max          AS psi_yesterday,\n",
        "  t.psi_max - y.psi_max AS psi_change,\n",
        "  t.pm25_avg         AS pm25_now,\n",
        "  y.pm25_avg         AS pm25_yesterday,\n",
        "  t.pm25_avg - y.pm25_avg AS pm25_change\n",
        "FROM workspace.hazer.gold_hourly_island t\n",
        "LEFT JOIN workspace.hazer.gold_hourly_island y\n",
        "  ON y.reading_ts = t.reading_ts - INTERVAL 24 HOURS\n",
        "WHERE t.reading_ts = (SELECT max(reading_ts) FROM workspace.hazer.gold_hourly_island);"
      ]
    }
  ],
